<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res/pl.mkrstudio.truefootball3">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:weightSum="5.0">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginBottom="@dimen/margin_2dp"
            android:weightSum="3.0"
            android:layout_weight="1.0">
            <pl.mkrstudio.truefootball3.views.TileButton
                android:id="@id/button_edit_players"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0"
                custom:tileDrawable="@drawable/edit_players"
                custom:tileText="@string/edit_players" />
            <pl.mkrstudio.truefootball3.views.TileButton
                android:id="@id/button_edit_teams"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0"
                custom:tileDrawable="@drawable/edit_teams"
                custom:tileText="@string/edit_teams" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_2dp"
            android:layout_weight="3.0">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_15dp"
                    android:text="@string/edit_file_status" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/last_edit_date"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/last_edit_date_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/league_names_edited"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/league_names_edited_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/team_names_edited"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/team_names_edited_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/team_swapped"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/team_swapped_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/team_emblems_edited"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/team_emblems_edited_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/players_edited"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="left"
                        android:id="@id/players_edited_text_view"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="@dimen/margin_2dp"
            android:weightSum="3.0"
            android:layout_weight="1.0">
            <View
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.TileButton
                android:id="@id/button_choose_edit_file"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0"
                custom:tileDrawable="@drawable/choose_edit_file"
                custom:tileText="@string/choose_edit_file" />
            <pl.mkrstudio.truefootball3.views.TileButton
                android:id="@id/button_reset_edit_file"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0"
                custom:tileDrawable="@drawable/reset_edit_file"
                custom:tileText="@string/reset_edit_file" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>