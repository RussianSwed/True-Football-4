<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_15"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/date"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/competition"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <View
            android:background="#ffaaaaaa"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/margin_2dp"
            android:layout_marginTop="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:weightSum="10.0">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="3.0">
                <ImageView
                    android:id="@id/homeEmblem"
                    android:layout_width="@dimen/match_emblem_size"
                    android:layout_height="@dimen/match_emblem_size" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="4.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_45"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/result"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="3.0">
                <ImageView
                    android:id="@id/awayEmblem"
                    android:layout_width="@dimen/match_emblem_size"
                    android:layout_height="@dimen/match_emblem_size" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:weightSum="10.0">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="3.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/homeTeam"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:baselineAligned="false"
                android:layout_weight="4.0" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="3.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/awayTeam"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:ems="23" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>