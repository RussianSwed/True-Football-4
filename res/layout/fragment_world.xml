<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="4.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/rankingsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/helpHeader"
                android:background="@drawable/help"
                android:layout_width="@dimen/help_button_size"
                android:layout_height="@dimen/help_button_size"
                android:layout_marginLeft="@dimen/margin_5dp" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="3.0">
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_1"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_2"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_3"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="3.0">
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_4"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_5"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_6"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>
