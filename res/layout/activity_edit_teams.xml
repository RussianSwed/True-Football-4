<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:id="@id/mainView"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chooseTeamToEdit" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:weightSum="7.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowLeft1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/countrySpinner"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowRight1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:weightSum="7.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowLeft2"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/leagueSpinner"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowRight2"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/emblem"
                android:layout_width="@dimen/new_game_emblem_size"
                android:layout_height="@dimen/new_game_emblem_size" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:weightSum="7.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowLeft3"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/teamSpinner"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowRight3"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/editLeagueName"
            android:text="@string/edit_league_name"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/editTeamName"
            android:text="@string/editTeamName"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/editEmblem"
            android:text="@string/edit_emblem"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/swapWith"
            android:text="@string/swapWithOtherTeam"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>