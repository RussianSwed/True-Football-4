<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:weightSum="3.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft1"
            android:background="#00000000"
            android:visibility="invisible"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/substitutions"
            android:layout_weight="5.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight1"
            android:background="#00000000"
            android:visibility="invisible"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/lineup_layout"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip">
        <ListView
            android:orientation="horizontal"
            android:id="@id/lineup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@layout/whole_list_bg"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000" />
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/swap_button"
        android:background="@layout/shape_button"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/margin_4dp"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:text="@string/swap"
        style="@style/button" />
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ListView
            android:id="@id/bench"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@layout/whole_list_bg"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000" />
    </LinearLayout>
</LinearLayout>