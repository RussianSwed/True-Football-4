<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res/pl.mkrstudio.truefootball3">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="3.0">
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_squad"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/team"
            custom:tileText="@string/squad" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_tactics"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/tactics"
            custom:tileText="@string/tactics" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_training"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/training"
            custom:tileText="@string/training" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="3.0">
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_youth"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/youth_squad"
            custom:tileText="@string/youthTeams" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_friendlies"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/friendlies"
            custom:tileText="@string/friendlies" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_transfers"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/transfers"
            custom:tileText="@string/transfers" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="3.0">
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_opponents"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/opponents"
            custom:tileText="@string/opponents" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_dressing_room"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/locker_room"
            custom:tileText="@string/locker_room" />
        <pl.mkrstudio.truefootball3.views.TileButton
            android:id="@id/button_scouting"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_weight="1.0"
            custom:tileDrawable="@drawable/scouting"
            custom:tileText="@string/scouting" />
    </LinearLayout>
</LinearLayout>