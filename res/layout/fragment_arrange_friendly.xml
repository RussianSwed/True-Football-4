<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rival" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowLeft1"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/countrySpinner"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowRight1"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowLeft2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/teamSpinner"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowRight2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowLeft3"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/dateSpinner"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowRight3"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/venue" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowLeft4"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/homeAwaySpinner"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/arrowRight4"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:id="@id/notes"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/cancel"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:text="@string/cancel"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/ok"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:text="@string/ok"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>