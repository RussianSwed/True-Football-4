<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/hallOfFame" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:weightSum="6.0"
            android:minHeight="@dimen/button_height">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowLeft1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/range"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="4.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowRight1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ViewFlipper
            android:id="@id/leaderboards"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_10dp">
            <ListView
                android:orientation="horizontal"
                android:id="@id/leaderboard1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/leaderboard2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/leaderboard3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/leaderboard4"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/leaderboard5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </ViewFlipper>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/userPlace"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/leaderboard_height"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:weightSum="80.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/place"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="11.0" />
            <LinearLayout
                android:gravity="center"
                android:id="@id/nationLL"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="10.0">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/nation"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/leaderboard_flag_height" />
            </LinearLayout>
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@id/name"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="48.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/points"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="11.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/submitScore"
            android:text="@string/ok"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>