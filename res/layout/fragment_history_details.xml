<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/firstLayout"
        android:background="@layout/shape_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft1"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/seasonHeader"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="5.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight1"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/secondLayout"
        android:background="@layout/shape_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft2"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/competitionHeader"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="5.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight2"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/thirdLayout"
        android:background="@layout/shape_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="3.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_10"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/wins"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_10"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/draws"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_10"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/losses"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="3.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_32"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/wins"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_32"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/draws"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_32"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/losses"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_10"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            android:text="@string/goals" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_32"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/goals"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/playersHeader"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            android:weightSum="11.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textColor="#ffffffff"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text=" "
                android:layout_weight="9.0" />
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/smallApps"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:src="@drawable/small_apps"
                android:layout_weight="1.0" />
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/smallGoals"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:src="@drawable/small_goals"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ListView
            android:id="@id/playersLV"
            android:background="@layout/shape_background_transparent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@layout/whole_list_bg"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000" />
    </LinearLayout>
</LinearLayout>