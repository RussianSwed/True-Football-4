<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false">
        <shape>
            <solid
                android:color="#ff666666" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="#ffb4b4b4" />
            <corners
                android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item
        android:state_pressed="true">
        <shape>
            <solid
                android:color="#ff88afdf" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="#ffb4b4b4" />
            <corners
                android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#ff72909c"
                android:endColor="#ff467085"
                android:angle="270.0" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="#ffa5c1cf" />
            <corners
                android:radius="@dimen/button_radius" />
        </shape>
    </item>
</selector>