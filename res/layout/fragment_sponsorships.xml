<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="6.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/sponsorshipsOffers"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="4.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/sponsorshipsOffersVF"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_2dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="@dimen/margin_2dp"
                    android:layout_marginBottom="@dimen/margin_2dp"
                    android:weightSum="6.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="4.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/monthlyIncome"
                        android:layout_weight="2.0" />
                </LinearLayout>
                <ListView
                    android:id="@id/sponsorshipList"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="@layout/whole_list_bg"
                    android:scrollingCache="false"
                    android:cacheColorHint="#00000000" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginBottom="@dimen/margin_2dp">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:id="@id/noOffers"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/noOffers" />
                <RelativeLayout
                    android:id="@id/sponsorshipOffersRL"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginBottom="@dimen/button_height_with_margin">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_2dp"
                            android:layout_marginBottom="@dimen/margin_2dp"
                            android:weightSum="6.0">
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_10"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:layout_weight="4.0" />
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_10"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/monthlyIncome"
                                android:layout_weight="2.0" />
                        </LinearLayout>
                        <ListView
                            android:id="@id/sponsorshipOffersList"
                            android:background="@layout/shape_background_transparent"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:listSelector="@layout/whole_list_bg"
                            android:scrollingCache="false"
                            android:cacheColorHint="#00000000" />
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/button_height_with_margin"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_alignParentBottom="true">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:weightSum="2.0">
                            <pl.mkrstudio.truefootball3.views.CustomFontButton
                                android:id="@id/rejectOffer"
                                android:layout_width="0.0dip"
                                android:layout_marginRight="@dimen/margin_2dp"
                                android:text="@string/rejectOffer"
                                android:layout_weight="1.0"
                                style="@style/default_button" />
                            <pl.mkrstudio.truefootball3.views.CustomFontButton
                                android:id="@id/acceptOffer"
                                android:layout_width="0.0dip"
                                android:layout_marginLeft="@dimen/margin_2dp"
                                android:text="@string/acceptOffer"
                                android:layout_weight="1.0"
                                style="@style/default_button" />
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>