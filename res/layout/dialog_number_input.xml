<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontEditText
        android:textSize="@dimen/text_size_16"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/number_input"
        android:background="@layout/shape_background_transparent"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/edit_text_height"
        android:inputType="number" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/okLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/ok"
            android:text="@string/ok"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>