<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="6.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="4.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/trainingHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/helpHeader"
                android:background="@drawable/help"
                android:layout_width="@dimen/help_button_size"
                android:layout_height="@dimen/help_button_size"
                android:layout_marginLeft="@dimen/margin_5dp" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/trainingVF"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/fitness"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/fitness"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/ballPossession"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/ballPossession"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/setPieces"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/setPieces"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/attacking"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/attacking"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/defending"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/defending"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/mental"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.ValuePicker
                    android:layout_gravity="center"
                    android:id="@id/mental"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/valuepicker_height"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/cannotGoToTrainingCampLL"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/cannotGoToTrainingCamp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:text="@string/cannotGoToTrainingCamp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/onTrainingCampLL"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/onTrainingCamp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/trainingCampPlannedLL"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/trainingCampPlannedTV"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp" />
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="fill_vertical"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <RelativeLayout
                    android:id="@id/centerView"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="@dimen/button_height_with_margin">
                    <ScrollView
                        android:id="@id/trainingCampPlanning"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_13"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_5dp"
                                android:text="@string/departureDate" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:layout_marginBottom="@dimen/margin_15dp">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft2"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/departureDateSpinner"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight2"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_13"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_5dp"
                                android:text="@string/returnDate" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:layout_marginBottom="@dimen/margin_15dp">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft3"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/returnDateSpinner"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight3"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_13"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_5dp"
                                android:text="@string/placeOfCamp" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:layout_marginBottom="@dimen/margin_15dp">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft4"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/placeOfCampSpinner"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight4"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_13"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_5dp"
                                android:text="@string/playFriendlyMatches" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:layout_marginBottom="@dimen/margin_15dp">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft5"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/playFriendlyMatchesSpinner"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight5"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_13"
                                    android:textColor="#ffffffff"
                                    android:gravity="right"
                                    android:paddingRight="@dimen/margin_5dp"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/costOfCamp"
                                    android:layout_weight="1.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="bold"
                                    android:textColor="#ffffffff"
                                    android:id="@id/costOfCamp"
                                    android:paddingLeft="@dimen/margin_5dp"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/margin_15dp"
                                android:weightSum="2.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_13"
                                    android:textColor="#ffffffff"
                                    android:gravity="right"
                                    android:paddingRight="@dimen/margin_5dp"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/weatherConditions"
                                    android:layout_weight="1.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="bold"
                                    android:textColor="#ffffffff"
                                    android:id="@id/weatherConditions"
                                    android:paddingLeft="@dimen/margin_5dp"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@id/bottomView"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/button_height_with_margin"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:id="@id/ok"
                            android:text="@string/ok"
                            style="@style/default_button" />
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="6.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/trainingResultsArrowLeft"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/trainingResultsHeader"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/trainingResultsArrowRight"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <ViewFlipper
                android:id="@id/trainingResultsVF"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="39.0">
                        <View
                            android:layout_width="0.0dip"
                            android:layout_height="1.0dip"
                            android:layout_weight="21.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@id/parameter"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/skill"
                            android:layout_weight="18.0" />
                    </LinearLayout>
                    <ListView
                        android:orientation="horizontal"
                        android:id="@id/overviewResultsLV"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_15"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:id="@id/noResults"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:layout_marginBottom="@dimen/margin_10dp"
                        android:text="@string/noResults" />
                    <ListView
                        android:id="@id/trainingResults"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>