<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/loanAmount" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:layout_marginBottom="@dimen/margin_15dp">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowLeft1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/amountSpinner"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowRight1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/monthsToRepayment" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:layout_marginBottom="@dimen/margin_15dp">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowLeft2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/monthSpinner"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/arrowRight2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/monthlyInstalment"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/okLayout"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/button_height"
        android:weightSum="2.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/cancel"
            android:layout_width="0.0dip"
            android:layout_marginRight="@dimen/margin_2dp"
            android:text="@string/cancel"
            android:layout_weight="1.0"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/ok"
            android:layout_width="0.0dip"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:text="@string/ok"
            android:layout_weight="1.0"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>