<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_3dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selectCountriesToFollow" />
    </LinearLayout>
    <ScrollView
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/choose_country_dialog_height">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="2.0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/leftLL"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/rightLL"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
    </ScrollView>
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/confirm"
        android:layout_width="fill_parent"
        android:text="@string/confirm"
        style="@style/default_button" />
</LinearLayout>