            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/main_layout_padding">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_10"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/formationName" />
            <pl.mkrstudio.truefootball3.views.CustomFontEditText
                android:textSize="@dimen/text_size_16"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/formationName"
