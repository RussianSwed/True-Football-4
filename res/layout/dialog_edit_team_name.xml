<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/change_name_dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_18"
        android:textColor="#ffffffff"
        android:layout_gravity="center_vertical"
        android:paddingLeft="@dimen/margin_2dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/insertNewTeamName" />
    <pl.mkrstudio.truefootball3.views.CustomFontEditText
        android:textSize="@dimen/text_size_16"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/teamName"
        android:background="@layout/shape_background_transparent"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/edit_text_height" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/okLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/ok"
            android:text="@string/ok"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>