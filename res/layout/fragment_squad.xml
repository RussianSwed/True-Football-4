<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/nextMatchLL"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_4dp">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nextMatch" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/nextMatchTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/nextMatchDateTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/positionsLL"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="11.0" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/subsLL"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="7.0" />
        </LinearLayout>
        <RelativeLayout
            android:layout_gravity="fill_vertical"
            android:orientation="vertical"
            android:id="@id/mainView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:id="@id/topView"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/teamOptions"
                        android:text="@string/playerOptions"
                        style="@style/default_button" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/centerView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginBottom="@dimen/button_height_with_margin"
                android:layout_below="@id/topView">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <ListView
                        android:orientation="horizontal"
                        android:id="@id/squadLV"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@id/bottomView"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/button_height_with_margin"
                android:layout_alignParentBottom="true">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:id="@id/button_proceed_to_motivational_speech"
                    android:background="@layout/shape_button"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:text="@string/continueString"
                    style="@style/button" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/multi_release_buttons_layout"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2dp"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/multi_release_cancel_button"
                        android:layout_width="0.0dip"
                        android:layout_marginRight="@dimen/margin_2dp"
                        android:text="@string/cancel"
                        android:layout_weight="1.0"
                        style="@style/default_button" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/multi_release_ok_button"
                        android:layout_width="0.0dip"
                        android:layout_marginLeft="@dimen/margin_2dp"
                        android:text="@string/ok"
                        android:layout_weight="1.0"
                        style="@style/default_button" />
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>