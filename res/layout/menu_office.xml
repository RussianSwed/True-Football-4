<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/button_squad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="squad" />
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/button_tactics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tactics" />
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/button_training"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="training" />
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/button_youth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="youth" />
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/button_friendlies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="friendlies" />
</LinearLayout>