<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/tile_button_main_layout"
    android:background="@layout/shape_button_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:weightSum="4.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="3.0">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/tile_button_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_10"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/tile_button_text_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:inputType="textMultiLine"
        android:textAllCaps="true" />
</LinearLayout>