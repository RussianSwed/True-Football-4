<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft1"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/teamIndividual"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="5.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight1"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/teamIndividualVF"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/margin_4dp">
        <RelativeLayout
            android:layout_gravity="fill_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:id="@id/centerView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginBottom="@dimen/button_height_with_margin">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_4dp"
                        android:layout_marginBottom="@dimen/margin_15dp">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowLeft2"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableLeft="@drawable/arrow_left"
                            android:layout_weight="1.0" />
                        <Spinner
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/formation"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowRight2"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/arrow_right"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/pitch"
                        android:layout_width="@dimen/tactics_pitch_width"
                        android:layout_height="@dimen/tactics_pitch_height">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/forwards"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_20" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/offensiveMidfielders"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_10" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/midfielders"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_10" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/defensiveMidfielders"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_10" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/defenders"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_10" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/sweepers"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_5" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/goalkeeper"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/tactics_pitch_line_height"
                            android:layout_marginTop="@dimen/tactics_pitch_line_margin_10" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@id/bottomView"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/button_height_with_margin"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/createNewFormation"
                        android:text="@string/createNewFormation"
                        style="@style/default_button" />
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ScrollView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gameplay" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginBottom="@dimen/margin_15dp">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowLeft3"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableLeft="@drawable/arrow_left"
                            android:layout_weight="1.0" />
                        <Spinner
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/gameplay"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowRight3"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/arrow_right"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:text="@string/pressing" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginBottom="@dimen/margin_15dp">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowLeft4"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableLeft="@drawable/arrow_left"
                            android:layout_weight="1.0" />
                        <Spinner
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/pressing"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowRight4"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/arrow_right"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:text="@string/timeWasting" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginBottom="@dimen/margin_15dp">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowLeft5"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableLeft="@drawable/arrow_left"
                            android:layout_weight="1.0" />
                        <Spinner
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/timeWasting"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowRight5"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/arrow_right"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:text="@string/offsideTraps" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginBottom="@dimen/margin_15dp">
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowLeft6"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableLeft="@drawable/arrow_left"
                            android:layout_weight="1.0" />
                        <Spinner
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/offsideTraps"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/arrowRight6"
                            android:background="#00000000"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/arrow_right"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginBottom="@dimen/margin_15dp">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/arrowLeft7"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/individualOrders"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/arrowRight7"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <ListView
                android:orientation="horizontal"
                android:id="@id/ordersLV"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>