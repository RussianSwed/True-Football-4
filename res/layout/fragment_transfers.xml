<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="6.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/transfersHeader"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="4.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/transfersVF"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/ok"
                android:layout_marginTop="0.0dip"
                android:text="@string/search2"
                style="@style/default_button" />
            <View
                android:id="@id/fillerView"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_4dp" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/playersLL"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_4dp">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:id="@id/knownPlayers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <View
                    android:background="#ffaaaaaa"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/margin_2dp"
                    android:layout_marginTop="@dimen/margin_5dp"
                    android:layout_marginBottom="@dimen/margin_5dp" />
                <ListView
                    android:orientation="horizontal"
                    android:id="@id/searchPlayersLV"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@layout/whole_list_bg"
                    android:scrollingCache="false"
                    android:cacheColorHint="#00000000" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ListView
                android:orientation="horizontal"
                android:id="@id/offersReceivedLV"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ListView
                android:orientation="horizontal"
                android:id="@id/offersMadeLV"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>