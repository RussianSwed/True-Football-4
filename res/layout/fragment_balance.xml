<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/accountBalance" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/accountBalance"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp"
        android:weightSum="6.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/month"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="4.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="2.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textColor="#ffffffff"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/monthlyBalance"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@id/monthlyBalance"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_15dp"
            android:weightSum="2.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#ffffffff"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/expenditures"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@id/expenditures"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ListView
            android:id="@id/expenditureList"
            android:background="@layout/shape_background_transparent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@layout/whole_list_bg"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_15dp"
            android:weightSum="2.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#ffffffff"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/revenue"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@id/revenue"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ListView
            android:id="@id/revenueList"
            android:background="@layout/shape_background_transparent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@layout/whole_list_bg"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000" />
    </LinearLayout>
</LinearLayout>