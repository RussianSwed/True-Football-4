<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@drawable/main_background"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    android:minHeight="@dimen/dialog_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/offerTitle"
        android:background="@layout/shape_background"
        android:paddingTop="@dimen/margin_15dp"
        android:paddingBottom="@dimen/margin_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:paddingTop="@dimen/margin_15dp"
        android:paddingBottom="@dimen/margin_15dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_15dp"
            android:text="@string/playerTapToShowDetails" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:id="@id/player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_15dp" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/offeredPriceLL"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offeredPrice" />
        <pl.mkrstudio.truefootball3.views.ValuePicker
            android:layout_gravity="center"
            android:id="@id/offer"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/margin_10dp" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/offeredSalaryLL"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offeredSalary" />
        <pl.mkrstudio.truefootball3.views.ValuePicker
            android:layout_gravity="center"
            android:id="@id/salaryOffer"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/margin_10dp" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/contractUntilLL"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contractUntil" />
        <pl.mkrstudio.truefootball3.views.ValuePicker
            android:layout_gravity="center"
            android:id="@id/contractEndOffer"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/margin_10dp" />
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/agentWillBePaid"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/margin_4dp"
        android:weightSum="2.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:textStyle="bold"
            android:id="@id/no"
            android:layout_width="0.0dip"
            android:layout_marginTop="0.0dip"
            android:layout_marginRight="@dimen/margin_2dp"
            android:layout_weight="1.0"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:textStyle="bold"
            android:id="@id/yes"
            android:layout_width="0.0dip"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginTop="0.0dip"
            android:layout_weight="1.0"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>