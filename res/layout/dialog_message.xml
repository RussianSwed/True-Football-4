<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/buttons"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:textStyle="bold"
                    android:id="@id/leftButton"
                    android:layout_width="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:text="@string/previous"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:textStyle="bold"
                    android:id="@id/rightButton"
                    android:layout_width="0.0dip"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_marginTop="0.0dip"
                    android:text="@string/next"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/conference_face_size"
                android:weightSum="5.0">
                <LinearLayout
                    android:background="#ffcccccc"
                    android:layout_width="@dimen/conference_face_size"
                    android:layout_height="@dimen/conference_face_size"
                    android:layout_marginRight="@dimen/margin_2dp">
                    <ImageView
                        android:id="@id/face"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="@dimen/margin_2dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_10"
                            android:textColor="#ffffffff"
                            android:paddingLeft="@dimen/margin_3dp"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/date"
                            android:layout_weight="1.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="#ffffffff"
                            android:id="@id/date"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_10"
                            android:textColor="#ffffffff"
                            android:id="@id/from2"
                            android:paddingLeft="@dimen/margin_3dp"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/from"
                            android:layout_weight="1.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="#ffffffff"
                            android:id="@id/from"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <ScrollView
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:id="@id/content"
                        android:padding="@dimen/margin_3dp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="1.0dip" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/actionButton"
                        style="@style/default_button" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>