<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="6.0">
            <ImageView
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:src="@drawable/star2"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_18"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:paddingLeft="@dimen/margin_3dp"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/achievementUnlocked"
                android:layout_weight="5.0" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#ffaaaaaa"
        android:layout_width="fill_parent"
        android:layout_height="2.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="5.0dip" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="#ffffffff"
        android:id="@id/achievements"
        android:paddingLeft="@dimen/margin_3dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <pl.mkrstudio.truefootball3.views.CustomFontButton
        android:id="@id/ok"
        android:text="@string/ok"
        style="@style/default_button" />
</LinearLayout>