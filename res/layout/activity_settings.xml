<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_2dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/matchSpeed"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/matchSpeed" />
        <SeekBar
            android:id="@id/matchSpeedSeekBar"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_15dp" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/simulationMode" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_15dp">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowLeft1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/simulationMode"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowRight1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/autosave" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_15dp">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowLeft2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/autosave"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowRight2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/currency" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_15dp">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowLeft3"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/currency"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowRight3"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2dp"
            android:weightSum="5.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#ffffffff"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_5dp"
                android:text="@string/sound"
                android:layout_weight="4.0" />
            <CheckBox
                android:gravity="center"
                android:id="@id/sound"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:background="@layout/shape_background_transparent"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/margin_5dp"
            android:text="Редактор разработчика"
            android:onClick="openDeveloperTools" />
    </LinearLayout>
</LinearLayout>