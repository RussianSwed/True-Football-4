<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/header_height"
            android:layout_marginBottom="@dimen/margin_4dp">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/opponents" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_4dp">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_13"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selectTeamToAnalyze" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2dp">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowLeft1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/countrySpinner"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowRight1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:weightSum="7.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowLeft2"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/leagueSpinner"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrowRight2"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2dp">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowLeft3"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <Spinner
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/teamSpinner"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowRight3"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/show_squad"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:text="@string/show_squad"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/analyze"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:text="@string/analyze"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:id="@id/mainView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/centerView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginBottom="@dimen/button_height_with_margin"
            android:layout_below="@id/topView">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip"
                    android:text="@string/analyzedOpponents" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="2.0dip">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="15.0sp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:id="@id/noTeamsAnalysedTV"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:text="@string/noTeamsAnalysed" />
                    <ListView
                        android:orientation="horizontal"
                        android:id="@id/teamsAnalysedLV"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height_with_margin"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/remove"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:text="@string/remove"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/results"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:text="@string/results"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>