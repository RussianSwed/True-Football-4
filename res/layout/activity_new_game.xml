<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/newGameLayout"
        android:background="@layout/shape_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chooseYourTeam" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:weightSum="7.0">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/arrowLeft1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/countrySpinner"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/arrowRight1"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:weightSum="7.0">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/arrowLeft2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/leagueSpinner"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/arrowRight2"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:weightSum="9.0">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="2.0">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="@dimen/new_game_money_size"
                    android:layout_height="@dimen/new_game_money_size"
                    android:src="@drawable/money" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/teamBudget"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/emblem"
                    android:layout_width="@dimen/new_game_emblem_size"
                    android:layout_height="@dimen/new_game_emblem_size" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/stars"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="2.0">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="@dimen/new_game_stadium_size"
                    android:layout_height="@dimen/new_game_stadium_size"
                    android:src="@drawable/stadium" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/teamStadiumCapacity"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:weightSum="7.0">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="bottom"
                android:id="@id/arrowLeft3"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/arrow_left"
                android:layout_weight="1.0" />
            <Spinner
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/teamSpinner"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="5.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="bottom"
                android:id="@id/arrowRight3"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/arrow_right"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_15dp"
            android:text="@string/followedCountries" />
        <org.apmem.tools.layouts.FlowLayout
            android:gravity="center"
            android:id="@id/observedLeaguesFL"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/addCountriesLL"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/help_button_size"
                    android:layout_height="@dimen/help_button_size"
                    android:src="@drawable/plus" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_4dp"
                    android:text="@string/add" />
            </LinearLayout>
        </org.apmem.tools.layouts.FlowLayout>
    </LinearLayout>
    <RadioGroup
        android:id="@id/radioGroup"
        android:background="@layout/shape_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontRadioButton
            android:textSize="@dimen/text_size_12"
            android:textColor="#ffffffff"
            android:id="@id/editedRB"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/useEditedNames" />
        <pl.mkrstudio.truefootball3.views.CustomFontRadioButton
            android:textSize="@dimen/text_size_12"
            android:textColor="#ffffffff"
            android:id="@id/randomRB"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/useRandomNames" />
    </RadioGroup>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="2.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/button_random_pick"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_marginRight="@dimen/margin_2dp"
            android:text="@string/random_pick"
            android:layout_weight="1.0"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/button_start"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:text="@string/start"
            android:layout_weight="1.0"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>