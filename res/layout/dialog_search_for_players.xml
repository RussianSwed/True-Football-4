<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@drawable/main_background"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    android:minHeight="@dimen/dialog_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/centerView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginBottom="@dimen/button_height_with_margin">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ScrollView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playerName" />
                            <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                android:textSize="@dimen/text_size_16"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@id/playerName"
                                android:background="@layout/shape_background_transparent"
                                android:layout_width="fill_parent"
                                android:layout_height="@dimen/edit_text_height" />
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:id="@id/playerClubLabel"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/team" />
                            <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                android:textSize="@dimen/text_size_16"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@id/playerClub"
                                android:background="@layout/shape_background_transparent"
                                android:layout_width="fill_parent"
                                android:layout_height="@dimen/edit_text_height" />
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/playerNationality" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_4dp"
                                android:weightSum="7.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft1"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/countrySpinner"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight1"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:id="@id/playerPositionLabel"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/preferredPosition" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_4dp"
                                android:weightSum="7.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/arrowLeft2"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/arrow_left"
                                    android:layout_weight="1.0" />
                                <Spinner
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/playerPosition"
                                    android:background="@layout/shape_background_transparent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawSelectorOnTop="true"
                                    android:layout_weight="5.0" />
                                <pl.mkrstudio.truefootball3.views.CustomFontButton
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@id/arrowRight2"
                                    android:background="#00000000"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:drawableRight="@drawable/arrow_right"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2.0">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0">
                                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                        android:textSize="@dimen/text_size_14"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/playerAgeMin" />
                                    <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                        android:textSize="@dimen/text_size_16"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@id/playerMinAge"
                                        android:background="@layout/shape_background_transparent"
                                        android:layout_width="fill_parent"
                                        android:layout_height="@dimen/edit_text_height"
                                        android:maxLength="2" />
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0">
                                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                        android:textSize="@dimen/text_size_14"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/playerAgeMax" />
                                    <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                        android:textSize="@dimen/text_size_16"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@id/playerMaxAge"
                                        android:background="@layout/shape_background_transparent"
                                        android:layout_width="fill_parent"
                                        android:layout_height="@dimen/edit_text_height"
                                        android:maxLength="2" />
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2.0">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0">
                                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                        android:textSize="@dimen/text_size_14"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/minSkill" />
                                    <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                        android:textSize="@dimen/text_size_16"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@id/minSkill"
                                        android:background="@layout/shape_background_transparent"
                                        android:layout_width="fill_parent"
                                        android:layout_height="@dimen/edit_text_height"
                                        android:maxLength="2" />
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0">
                                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                        android:textSize="@dimen/text_size_14"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/maxSkill" />
                                    <pl.mkrstudio.truefootball3.views.CustomFontEditText
                                        android:textSize="@dimen/text_size_16"
                                        android:textColor="#ffffffff"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@id/maxSkill"
                                        android:background="@layout/shape_background_transparent"
                                        android:layout_width="fill_parent"
                                        android:layout_height="@dimen/edit_text_height"
                                        android:maxLength="2" />
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:background="#ffaaaaaa"
                                android:layout_width="fill_parent"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginBottom="5.0dip" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/margin_2dp"
                                android:weightSum="5.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_14"
                                    android:textColor="#ffffffff"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/margin_5dp"
                                    android:text="@string/includeEditedPlayers"
                                    android:layout_weight="4.0" />
                                <CheckBox
                                    android:gravity="center"
                                    android:id="@id/editedPlayers"
                                    android:layout_width="0.0dip"
                                    android:layout_height="@dimen/button_height"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/margin_2dp"
                                android:weightSum="5.0">
                                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                    android:textSize="@dimen/text_size_14"
                                    android:textColor="#ffffffff"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/margin_5dp"
                                    android:text="@string/includeRandomPlayers"
                                    android:layout_weight="4.0" />
                                <CheckBox
                                    android:gravity="center"
                                    android:id="@id/randomPlayers"
                                    android:layout_width="0.0dip"
                                    android:layout_height="@dimen/button_height"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height_with_margin"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_4dp"
                android:weightSum="2.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:textStyle="bold"
                    android:id="@id/clear"
                    android:layout_width="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:text="@string/clear"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:textStyle="bold"
                    android:id="@id/ok"
                    android:layout_width="0.0dip"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_marginTop="0.0dip"
                    android:text="@string/ok"
                    android:layout_weight="1.0"
                    style="@style/default_button" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>