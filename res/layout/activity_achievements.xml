<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:id="@id/mainView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/topView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="false">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:weightSum="6.0">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowLeft"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/achievementsTrophies"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4.0" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:layout_gravity="center"
                    android:id="@id/arrowRight"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/centerView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginBottom="@dimen/achievements_score_box_height_with_margin"
            android:layout_below="@id/topView">
            <ViewFlipper
                android:id="@id/achievementsTrophiesVF"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="7.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_14b"
                            android:textColor="#ffffffff"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/pointsForAchievements"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold"
                            android:textColor="#ffffff00"
                            android:gravity="center"
                            android:id="@id/pointsForAchievements"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="2.0" />
                    </LinearLayout>
                    <View
                        android:background="#ffaaaaaa"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/margin_2dp"
                        android:layout_marginTop="@dimen/margin_5dp"
                        android:layout_marginBottom="@dimen/margin_5dp" />
                    <ListView
                        android:id="@id/achievements"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="7.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_14"
                            android:textColor="#ffffffff"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/pointsForTrophies"
                            android:layout_weight="5.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold"
                            android:textColor="#ffffff00"
                            android:gravity="center"
                            android:id="@id/pointsForTrophies"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="2.0" />
                    </LinearLayout>
                    <View
                        android:background="#ffaaaaaa"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/margin_2dp"
                        android:layout_marginTop="@dimen/margin_5dp"
                        android:layout_marginBottom="@dimen/margin_5dp" />
                    <ListView
                        android:id="@id/trophies"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </ViewFlipper>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/achievements_score_box_height"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/achievements_your_score_box_score"
                    android:weightSum="6.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_17"
                        android:textColor="#ffffffff"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/yourScore"
                        android:layout_weight="4.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_20"
                        android:textStyle="bold"
                        android:textColor="#ffffff00"
                        android:gravity="center"
                        android:id="@id/yourScore"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.0" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/submitScore"
                    android:text="@string/submitScore"
                    style="@style/default_button" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>