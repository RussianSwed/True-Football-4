<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/noTrophies"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/noTrophies" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/trophiesLL"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/trophy_height">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/arrowLeft1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/arrow_left"
                    android:layout_weight="1.0" />
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="5.0">
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/trophy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/arrowRight1"
                    android:background="#00000000"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/arrow_right"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/trophyName"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/trophyDateAndTeam"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>