<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/centerView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginBottom="@dimen/button_height_with_margin">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/header_height"
                    android:layout_marginBottom="@dimen/margin_4dp"
                    android:weightSum="6.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/youthTeams" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_15"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:id="@id/noYouthTeams"
                    android:background="@layout/shape_background"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/noYouthTeams" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/youthTeamsLL"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_4dp"
                        android:weightSum="4.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:layout_gravity="left"
                            android:id="@id/position"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/trainer"
                            android:layout_weight="3.0" />
                    </LinearLayout>
                    <ListView
                        android:id="@id/youthTeams"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height_with_margin"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/createNewTeam"
                    android:text="@string/createNewTeam"
                    style="@style/default_button" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>