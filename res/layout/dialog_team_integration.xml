<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/dinnerLL"
                android:background="@layout/shape_background"
                android:padding="@dimen/main_layout_padding"
                android:paddingBottom="@dimen/margin_10dp"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/margin_2dp"
                android:layout_weight="1.0">
                <pl.mkrstudio.truefootball3.views.CustomFontRadioButton
                    android:textSize="@dimen/text_size_12"
                    android:textColor="#ffffffff"
                    android:id="@id/dinnerRB"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/organize_dinner" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/plus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_dinner_pros_1" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/plus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_dinner_pros_2" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/minus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:id="@id/organize_dinner_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_dinner_cons_1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/partyLL"
                android:background="@layout/shape_background"
                android:padding="@dimen/main_layout_padding"
                android:paddingBottom="@dimen/margin_10dp"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:layout_weight="1.0">
                <pl.mkrstudio.truefootball3.views.CustomFontRadioButton
                    android:textSize="@dimen/text_size_12"
                    android:textColor="#ffffffff"
                    android:id="@id/partyRB"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/organize_party" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/plus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_party_pros_1" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/plus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_party_pros_2" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/minus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_party_cons_1" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/list_item_mail_icon_height"
                        android:layout_marginRight="@dimen/margin_3dp"
                        android:src="@drawable/minus" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:id="@id/organize_party_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_dinner_cons_1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/okLayout"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/button_height"
        android:weightSum="2.0">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/cancel"
            android:layout_width="0.0dip"
            android:layout_marginRight="@dimen/margin_2dp"
            android:text="@string/cancel"
            android:layout_weight="1.0"
            style="@style/default_button" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:id="@id/ok"
            android:layout_width="0.0dip"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:text="@string/ok"
            android:layout_weight="1.0"
            style="@style/default_button" />
    </LinearLayout>
</LinearLayout>