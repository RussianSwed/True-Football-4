<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:weightSum="19.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/place"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="1.0" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/nationLL"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="3.0">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/flag"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/international_table_flag_size" />
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center|left"
        android:layout_gravity="center|left"
        android:id="@id/team"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="7.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/matches"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="1.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/wins"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="1.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/draws"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="1.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/losses"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="1.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:gravity="center"
        android:id="@id/goals"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="2.0" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_11"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@id/points"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/international_table_layout_size"
        android:layout_weight="2.0" />
</LinearLayout>