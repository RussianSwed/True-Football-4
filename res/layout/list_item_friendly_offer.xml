<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/list_item_job_offer_height"
    android:weightSum="11.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/emblem"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="2.0" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="@dimen/margin_10dp"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="6.0">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@id/rival"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/countryLL"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="10.0">
            <LinearLayout
                android:gravity="center"
                android:id="@id/flagLL"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/list_item_squad_flag_height"
                android:layout_weight="1.0">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:layout_gravity="center|left"
                android:id="@id/countryName"
                android:paddingLeft="@dimen/margin_4dp"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="9.0" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@id/date"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@id/status"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="3.0" />
</LinearLayout>