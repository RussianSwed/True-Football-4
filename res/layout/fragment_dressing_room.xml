<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/centerView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginBottom="@dimen/button_height_with_margin">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_4dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_weight="4.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/locker_room" />
                    </LinearLayout>
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/helpHeader"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/help"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="@dimen/margin_2dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_15"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:id="@id/noNewsObservations"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_10dp"
                        android:text="@string/noNewsObservations" />
                    <ListView
                        android:id="@id/newsObservations"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/button_height_with_margin"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/teamIntegration"
                    android:text="@string/team_integration"
                    style="@style/default_button" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>