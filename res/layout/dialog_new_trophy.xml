<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="6.0">
            <ImageView
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:src="@drawable/achievements"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="18.0sp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:paddingLeft="3.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/newTrophy"
                android:layout_weight="5.0" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#ffaaaaaa"
        android:layout_width="fill_parent"
        android:layout_height="2.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="5.0dip" />
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="14.0sp"
        android:textColor="#ffffffff"
        android:id="@id/trophy"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/okLayout"
        android:layout_width="fill_parent"
        android:layout_height="38.0dip"
        android:weightSum="4.0">
        <View
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@id/ok"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:layout_weight="2.0" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>