<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/header_height"
            android:weightSum="3.0">
            <View
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/youthTeam"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <LinearLayout
                android:gravity="right"
                android:layout_gravity="center|right"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/removeTeam"
                    android:paddingRight="@dimen/margin_5dp"
                    android:layout_width="@dimen/remove_icon_size"
                    android:layout_height="@dimen/remove_icon_size"
                    android:src="@drawable/delete" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp"
            android:weightSum="6.0">
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowLeft"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/youthTeamHeader"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="4.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/arrowRight"
                android:background="#00000000"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
        <ViewFlipper
            android:id="@id/youthTeamVF"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ListView
                    android:orientation="horizontal"
                    android:id="@id/squadLV"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="@layout/whole_list_bg"
                    android:scrollingCache="false"
                    android:cacheColorHint="#00000000" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/thisTeamHasNoTrainerLL"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_4dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thisTeamHasNoTrainer" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/youthTrainerLL"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_4dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trainer" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_15dp"
                        android:weightSum="10.0">
                        <LinearLayout
                            android:gravity="center"
                            android:id="@id/nationLL"
                            android:layout_width="0.0dip"
                            android:layout_height="@dimen/list_item_trainer_height"
                            android:layout_weight="1.0">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@id/nation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_15"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:gravity="center_vertical"
                            android:layout_gravity="left"
                            android:id="@id/name"
                            android:paddingLeft="@dimen/margin_4dp"
                            android:layout_width="0.0dip"
                            android:layout_height="@dimen/list_item_trainer_height"
                            android:layout_weight="7.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_15"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:gravity="center_vertical"
                            android:layout_gravity="center"
                            android:id="@id/experience"
                            android:paddingLeft="@dimen/margin_4dp"
                            android:layout_width="0.0dip"
                            android:layout_height="@dimen/list_item_trainer_height"
                            android:layout_weight="2.0" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:weightSum="7.0">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_14"
                            android:textColor="#ffffffff"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/monthlySpending"
                            android:layout_weight="4.0" />
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_14"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:gravity="center"
                            android:id="@id/youthTeamFinancing"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="3.0" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@id/youthTeamFinancingSeekBar"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_4dp"
                        android:layout_marginBottom="@dimen/margin_5dp" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/change_trainer"
                    android:layout_marginTop="0.0dip"
                    android:text="@string/change_trainer"
                    style="@style/default_button" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="6.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/trainingResultsArrowLeft"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/trainingResultsHeader"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="4.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:layout_gravity="center"
                        android:id="@id/trainingResultsArrowRight"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <ViewFlipper
                    android:id="@id/trainingResultsVF"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@layout/shape_background"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="39.0">
                            <View
                                android:layout_width="0.0dip"
                                android:layout_height="1.0dip"
                                android:layout_weight="21.0" />
                            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                                android:textSize="@dimen/text_size_12"
                                android:textColor="#ffffffff"
                                android:gravity="center"
                                android:layout_gravity="center_vertical"
                                android:id="@id/skill"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/skill"
                                android:layout_weight="18.0" />
                        </LinearLayout>
                        <ListView
                            android:orientation="horizontal"
                            android:id="@id/overviewResultsLV"
                            android:background="@layout/shape_background_transparent"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:listSelector="@layout/whole_list_bg"
                            android:scrollingCache="false"
                            android:cacheColorHint="#00000000" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@layout/shape_background"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <pl.mkrstudio.truefootball3.views.CustomFontTextView
                            android:textSize="@dimen/text_size_15"
                            android:textColor="#ffffffff"
                            android:layout_gravity="center"
                            android:id="@id/noResults"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:layout_marginBottom="@dimen/margin_10dp"
                            android:text="@string/noResults" />
                        <ListView
                            android:id="@id/trainingResults"
                            android:background="@layout/shape_background_transparent"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:listSelector="@layout/whole_list_bg"
                            android:scrollingCache="false"
                            android:cacheColorHint="#00000000" />
                    </LinearLayout>
                </ViewFlipper>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</LinearLayout>