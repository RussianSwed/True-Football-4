<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_12"
            android:textColor="#ffffffff"
            android:gravity="left"
            android:id="@id/date"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="2.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffffff"
                android:gravity="left"
                android:id="@id/competition"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@id/attendance"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
    <pl.mkrstudio.truefootball3.views.PossessionBar
        android:orientation="horizontal"
        android:id="@id/possessionBar"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/possession_bar_height"
        android:layout_marginBottom="@dimen/margin_4dp" />
    <LinearLayout
        android:orientation="vertical"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="10.0">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="3.0">
                <ImageView
                    android:id="@id/homeTeamEmblem"
                    android:layout_width="@dimen/match_emblem_size"
                    android:layout_height="@dimen/match_emblem_size" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center|top"
                    android:id="@id/homeTeamName"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="4.0">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_45"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/result"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_25"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/time"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/penaltiesResult"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="3.0">
                <ImageView
                    android:id="@id/awayTeamEmblem"
                    android:layout_width="@dimen/match_emblem_size"
                    android:layout_height="@dimen/match_emblem_size" />
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:gravity="center|top"
                    android:id="@id/awayTeamName"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/commentary_height"
        android:layout_marginBottom="@dimen/margin_4dp">
        <ImageView
            android:gravity="right"
            android:layout_width="@dimen/mic_height"
            android:layout_height="wrap_content"
            android:src="@drawable/mic" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/commentary"
            android:background="@drawable/commentary_bubble"
            android:paddingLeft="@dimen/margin_15dp"
            android:paddingRight="@dimen/margin_5dp"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/matchVF"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/match_squads_height"
        android:layout_marginBottom="@dimen/margin_4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/squadsLL"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="2.0">
            <ListView
                android:orientation="horizontal"
                android:id="@id/leftSquad"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000"
                android:layout_weight="1.0" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/rightSquad"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/reportLL"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ListView
                android:orientation="horizontal"
                android:id="@id/report"
                android:background="@layout/shape_background_transparent"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/commentaryLL"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ListView
                android:orientation="horizontal"
                android:id="@id/commentaryRecords"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/liveResultsLL"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2dp"
                android:layout_marginBottom="@dimen/margin_5dp"
                android:text="@string/live_results" />
            <ListView
                android:orientation="horizontal"
                android:id="@id/liveMatches"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
    </ViewFlipper>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp"
        android:weightSum="6.0">
        <ImageView
            android:id="@id/match_stats_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginRight="@dimen/margin_2dp"
            android:src="@drawable/match_stats"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/commentary_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginRight="@dimen/margin_2dp"
            android:src="@drawable/bubble_mic"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/live_results_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginRight="@dimen/margin_2dp"
            android:src="@drawable/live_results"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/subs_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginRight="@dimen/margin_2dp"
            android:src="@drawable/match_subs"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/tactics_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:layout_marginRight="@dimen/margin_2dp"
            android:src="@drawable/match_tactics"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/action_button"
            android:background="@layout/shape_button_background"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/match_button_height"
            android:layout_marginLeft="@dimen/margin_2dp"
            android:src="@drawable/match_play"
            android:layout_weight="1.0" />
    </LinearLayout>
    <com.google.android.gms.ads.AdView
        android:layout_gravity="center"
        android:id="@id/adView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-1066342364129157/5550221426" />
</LinearLayout>