<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4dp">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/friendliesHeader"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="5.0" />
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/friendliesVF"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:layout_gravity="fill_vertical"
            android:orientation="vertical"
            android:id="@id/mainView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:id="@id/topView"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/button_height_with_margin"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_15"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:id="@id/noFriendlies"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_10dp"
                        android:text="@string/noFriendlies" />
                    <ListView
                        android:id="@id/friendlyList"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@id/bottomView"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/button_height_with_margin"
                android:layout_alignParentBottom="true">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/arrangeFriendly"
                    android:text="@string/arrangeFriendlyMatch"
                    style="@style/default_button" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="fill_vertical"
            android:orientation="vertical"
            android:id="@id/mainView2"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:id="@id/topView2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/button_height_with_margin"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_15"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:id="@id/noFriendlyOffers"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_10dp"
                        android:text="@string/noFriendlyOffers" />
                    <ListView
                        android:id="@id/friendlyOffersList"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@id/bottomView2"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/button_height_with_margin"
                android:layout_alignParentBottom="true">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/acceptOffer"
                    android:text="@string/acceptOffer"
                    style="@style/default_button" />
            </RelativeLayout>
        </RelativeLayout>
    </ViewFlipper>
</LinearLayout>