<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:weightSum="4.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <pl.mkrstudio.truefootball3.views.CustomFontTextView
        android:textSize="@dimen/text_size_20"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@id/name"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/button_height"
        android:layout_weight="1.0" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/trainerLL"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/button_height"
        android:layout_weight="3.0">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/nation"
            android:layout_width="@dimen/list_item_youth_team_flag_size"
            android:layout_height="@dimen/list_item_youth_team_flag_size"
            android:layout_marginRight="@dimen/margin_5dp" />
        <pl.mkrstudio.truefootball3.views.CustomFontTextView
            android:textSize="@dimen/text_size_15"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/trainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>