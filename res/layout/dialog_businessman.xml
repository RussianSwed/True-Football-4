<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:background="@layout/selector_background_message"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="@dimen/dialog_width"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/conference_face_size"
            android:weightSum="5.0">
            <LinearLayout
                android:background="#ffcccccc"
                android:layout_width="@dimen/conference_face_size"
                android:layout_height="@dimen/conference_face_size"
                android:layout_marginRight="@dimen/margin_2dp">
                <ImageView
                    android:id="@id/face"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/margin_2dp" />
        </LinearLayout>
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="@dimen/margin_4dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@layout/shape_background"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#ffffffff"
                        android:id="@id/talk"
                        android:padding="@dimen/margin_4dp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <View
                        android:id="@id/divider"
                        android:background="#ffaaaaaa"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_marginBottom="5.0dip" />
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_18"
                        android:textColor="#ffffffff"
                        android:id="@id/question"
                        android:padding="@dimen/margin_4dp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/yesButton"
                    android:text="@string/yesyes"
                    style="@style/default_button" />
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/noButton"
                    android:text="@string/noThanks"
                    style="@style/default_button" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>