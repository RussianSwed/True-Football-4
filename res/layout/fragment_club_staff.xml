<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@layout/shape_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowLeft"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/arrow_left"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="4.0">
            <pl.mkrstudio.truefootball3.views.CustomFontTextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/employeesAndPeopleToHire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:layout_gravity="center"
                android:id="@id/helpHeader"
                android:background="@drawable/help"
                android:layout_width="@dimen/help_button_size"
                android:layout_height="@dimen/help_button_size"
                android:layout_marginLeft="@dimen/margin_5dp" />
        </LinearLayout>
        <pl.mkrstudio.truefootball3.views.CustomFontButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/arrowRight"
            android:background="#00000000"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/arrow_right"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ViewFlipper
        android:id="@id/employeesAndPeopleToHireVF"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/margin_4dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ListView
                android:id="@id/employeesLV"
                android:background="@layout/shape_background_transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:listSelector="@layout/whole_list_bg"
                android:scrollingCache="false"
                android:cacheColorHint="#00000000" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_13"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="7.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowLeft2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/roleSpinner"
                        android:background="@layout/shape_background_transparent"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowRight2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
            <pl.mkrstudio.truefootball3.views.CustomFontButton
                android:id="@id/ok"
                android:text="@string/search"
                style="@style/default_button" />
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_4dp">
                <ListView
                    android:id="@id/peopleToHireLV"
                    android:background="@layout/shape_background_transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="@layout/whole_list_bg"
                    android:scrollingCache="false"
                    android:cacheColorHint="#00000000" />
            </LinearLayout>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>