<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res/pl.mkrstudio.truefootball3">
    <ViewFlipper
        android:id="@id/mainFlipper"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="5.0">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginBottom="@dimen/margin_2dp"
                android:weightSum="3.0"
                android:layout_weight="1.0">
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_new_game"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:layout_weight="1.0"
                    custom:tileDrawable="@drawable/continue_drawable"
                    custom:tileText="@string/newGame" />
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_load_game"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:layout_weight="1.0"
                    custom:tileDrawable="@drawable/disc"
                    custom:tileText="@string/loadGame" />
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_language"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="@dimen/margin_2dp"
                android:layout_marginBottom="@dimen/margin_2dp"
                android:layout_weight="3.0">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:src="@drawable/logo" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="@dimen/margin_2dp"
                android:weightSum="3.0"
                android:layout_weight="1.0">
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_editor"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:layout_weight="1.0"
                    custom:tileDrawable="@drawable/editor"
                    custom:tileText="@string/editor" />
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_credits"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:layout_weight="1.0"
                    custom:tileDrawable="@drawable/info"
                    custom:tileText="@string/credits" />
                <pl.mkrstudio.truefootball3.views.TileButton
                    android:id="@id/button_achievements"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="@dimen/margin_2dp"
                    android:layout_marginRight="@dimen/margin_2dp"
                    android:layout_weight="1.0"
                    custom:tileDrawable="@drawable/achievements"
                    custom:tileText="@string/achievements" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@layout/shape_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/credits"
                android:layout_width="fill_parent"
                android:layout_height="5200.0dip">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_30"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@id/creditsTV1"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="True Football 3.10.2" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_20"
                        android:textColor="#ffffffff"
                        android:gravity="center|right"
                        android:id="@id/creditsTV2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="© 2024 MKR Studio" />
                    <ImageView
                        android:background="@drawable/pol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_8dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/creditsSpecialThanksLL"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/creditsSpecialThanksTV"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_15dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/graphicsTeamEmblemsLL"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/creditsTV6"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_15dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/database2022"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/creditsTV5"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_15dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/translation"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/creditsTV3"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_15dp"
                        android:text="@string/translation" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/database"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/creditsTV4"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/margin_15dp"
                        android:text="@string/database" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>