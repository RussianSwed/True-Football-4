<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/mainLayout"
    android:padding="@dimen/main_layout_padding"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:id="@id/mainView"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/topView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/two_buttons_height_with_margin"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="false">
            <LinearLayout
                android:orientation="vertical"
                android:background="@layout/shape_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chooseTeamToEdit" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:weightSum="7.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowLeft1"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/countrySpinner"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowRight1"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:weightSum="7.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowLeft2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/leagueSpinner"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowRight2"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:weightSum="7.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowLeft3"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/arrow_left"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/teamSpinner"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="5.0" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/arrowRight3"
                        android:background="#00000000"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/arrow_right"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp">
                    <pl.mkrstudio.truefootball3.views.CustomFontTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customPlayers" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ListView
                        android:orientation="horizontal"
                        android:id="@id/customPlayers"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="@dimen/margin_4dp"
                        android:listSelector="@layout/whole_list_bg"
                        android:scrollingCache="false"
                        android:cacheColorHint="#00000000" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/bottomView"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/two_buttons_height_with_margin"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <pl.mkrstudio.truefootball3.views.CustomFontButton
                    android:id="@id/move"
                    android:layout_width="fill_parent"
                    android:text="@string/move"
                    style="@style/default_button" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:weightSum="2.0">
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/delete"
                        android:layout_width="0.0dip"
                        android:layout_marginRight="@dimen/margin_2dp"
                        android:text="@string/delete"
                        android:layout_weight="1.0"
                        style="@style/default_button" />
                    <pl.mkrstudio.truefootball3.views.CustomFontButton
                        android:id="@id/edit"
                        android:layout_width="0.0dip"
                        android:layout_marginLeft="@dimen/margin_2dp"
                        android:text="@string/edit"
                        android:layout_weight="1.0"
                        style="@style/default_button" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>